{
  "name": "throttle-near-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Adaptive spending-control vault for autonomous AI agents on NEAR Protocol",
  "scripts": {
    "build:contract": "cd contracts/throttle-vault && cargo build --target wasm32-unknown-unknown --release",
    "test:contract": "cd contracts/throttle-vault && cargo check --target wasm32-unknown-unknown",
    "install:all": "npm.cmd --prefix backend install && npm.cmd --prefix frontend install",
    "test:backend": "npm.cmd --prefix backend test",
    "build:frontend": "npm.cmd --prefix frontend run build",
    "start:backend": "npm.cmd --prefix backend start",
    "dev:backend": "npm.cmd --prefix backend run dev",
    "dev:frontend": "npm.cmd --prefix frontend run dev",
    "test:all": "npm run test:contract && npm run test:backend && npm run build:frontend"
  },
  "keywords": [
    "near",
    "ai",
    "security",
    "autonomous-agents",
    "smart-contract",
    "rust"
  ],
  "author": "",
  "license": "Apache-2.0"
}

