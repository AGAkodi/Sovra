# Chain mode: leave unset to auto-detect (testnet if vault + agent creds are set,
# otherwise simulation). 'testnet' makes missing creds a startup error;
# 'simulation' never broadcasts (tests force this).
# NEAR_MODE=testnet

# NEAR Network Configuration (NEAR_NETWORK is also the chain_id bound into attestations)
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_ARCHIVAL_RPC_URL=https://archival-rpc.testnet.near.org

# Smart Contract Vault
VAULT_CONTRACT_ID=throttle-vault.testnet

# Accounts & Identities
OWNER_ACCOUNT_ID=throttle-owner.testnet
AGENT_ACCOUNT_ID=throttle-agent.testnet
RECIPIENT_ACCOUNT_ID=service-worker.testnet
ATTACKER_ACCOUNT_ID=attacker-probe.testnet

# Generate both key pairs with: npm --prefix backend run keygen
# Offchain Policy Signer Keypair (Ed25519)
# Public key registered in Vault contract; Private key kept securely in backend
POLICY_SIGNER_PUBLIC_KEY=ed25519:6E5...
POLICY_SIGNER_PRIVATE_KEY=ed25519:3qK...

# Agent Function-Call Key (Restricted strictly to vault.request_payment)
AGENT_PUBLIC_KEY=ed25519:9Xy...
AGENT_PRIVATE_KEY=ed25519:4aZ...

# Backend & Database
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/throttle_db
JWT_SECRET=super-secret-throttle-jwt-key-change-me

# Frontend Configuration
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=https://rpc.testnet.near.org
VITE_VAULT_CONTRACT_ID=throttle-vault.testnet
VITE_API_URL=http://localhost:3001

