# Chain mode: leave unset to auto-detect (testnet if vault + agent creds are set,
# otherwise simulation). 'testnet' makes missing creds a startup error;
# 'simulation' never broadcasts (tests force this).
# NEAR_MODE=testnet

# Demo amount scale in (0, 1]. 0.1 => 0.3 / 2.5 / 8 NEAR scenarios, 3 NEAR cap,
# 10 NEAR daily budget (fits faucet balances). Must match the value used when
# running scripts/deploy.ts, since the on-chain caps are set at deploy time.
# DEMO_SCALE=0.1

# Path to the deployable wasm (CI artifact "throttle_vault-wasm"); optional.
# WASM_PATH=

# NEAR Network Configuration (NEAR_NETWORK is also the chain_id bound into attestations)
NEAR_NETWORK=testnet
# rpc.testnet.near.org is deprecated and rate-limited (HTTP 429); use FastNEAR or another provider.
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_ARCHIVAL_RPC_URL=https://archival-rpc.testnet.fastnear.com

# Smart Contract Vault
VAULT_CONTRACT_ID=throttle-vault.testnet

# Accounts & Identities
OWNER_ACCOUNT_ID=throttle-owner.testnet
AGENT_ACCOUNT_ID=throttle-agent.testnet
RECIPIENT_ACCOUNT_ID=service-worker.testnet
ATTACKER_ACCOUNT_ID=attacker-probe.testnet

# Generate both key pairs with: npm --prefix backend run keygen
# Offchain Policy Signer Keypair (Ed25519)
# Public key registered in Vault contract; Private key kept securely in backend
POLICY_SIGNER_PUBLIC_KEY=ed25519:6E5...
POLICY_SIGNER_PRIVATE_KEY=ed25519:3qK...

# Agent Function-Call Key (Restricted strictly to vault.request_payment)
AGENT_PUBLIC_KEY=ed25519:9Xy...
AGENT_PRIVATE_KEY=ed25519:4aZ...

# Backend
PORT=3001

# Persistence (Supabase). Backend only: never put these in VITE_ variables.
# Leave empty to use the in-memory store (lost on restart).
#   SUPABASE_URL:              Project Settings > API > Project URL
#   SUPABASE_SERVICE_ROLE_KEY: Project Settings > API keys > service_role (secret)
#   SUPABASE_DB_URL:           Connect > Session pooler connection string (with your DB password);
#                              only used by scripts/apply-migrations to create the tables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# STORE_MODE=supabase   # force: fail at startup if Supabase is not configured

# Hosting (Vercel)
# CORS_ORIGINS=https://your-frontend.vercel.app
# CRON_SECRET=           # protects /cron/reconcile (Vercel Cron sends it automatically)
# SPEND_RATE_LIMIT_PER_MIN=6

# Frontend Configuration
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=https://test.rpc.fastnear.com
# Backend URL for a hosted frontend (e.g. https://throttle-api-mauve.vercel.app). Leave unset locally:
# Vite proxies /api to the backend on port 3001.
# VITE_API_BASE=


# LLM agent (Groq). Empty = scripted agent. Backend only; never a VITE_ variable.
#   Key: console.groq.com > API Keys > Create API Key
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# AGENT_MODE=scripted   # force scripted even when a key is set
